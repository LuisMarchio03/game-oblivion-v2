; Engine configuration file.
config_version=5

[application]

config/name="Oblivion"
config/description="Um jogo de enigmas em HD-2D sobre esquecer e lembrar."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false

[autoload]

Game="*res://scripts/autoload/game.gd"
Audio="*res://scripts/autoload/audio.gd"
Ui="*res://scripts/autoload/ui.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/VT323-Regular.ttf"
theme/default_font_antialiasing=0

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/default_filters/anisotropic_filtering_level=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
anti_aliasing/quality/screen_space_aa=0
rendering_device/fallback_to_d3d12=true
rendering_device/fallback_to_opengl3=true
